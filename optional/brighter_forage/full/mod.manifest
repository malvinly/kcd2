<?xml version="1.0" encoding="utf-8"?>
<kcd_mod>
  <info>
    <name>Brighter Forage (every herb on its own)</name>
    <modid>brighter_forage</modid>
    <description>Pickable herbs and mushrooms, bird&apos;s nests, beehives, fish traps, buried treasure and graves are brighter so they stand out. Grass, tree fungi and stork nests keep their vanilla look. A key (F5 to start with) makes all of them bright magenta for 30 seconds; settings.cfg in the mod folder sets the key, the length and each one&apos;s colour, every herb kind on its own (Belladonna, Herb Paris and fly agaric gold to start with). Costs the most frame rate where many herb kinds grow.</description>
    <author>malvinly</author>
    <version>0.4.0</version>
    <created_on>2026-11-06</created_on>
    <modifies_level>false</modifies_level>
  </info>
</kcd_mod>
