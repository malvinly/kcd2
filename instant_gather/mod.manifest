<kcd_mod>
  <info>
    <name>Instant Gather</name>
    <modid>instant_gather</modid>
    <description>Gathering herbs and mushrooms is quick: no kneeling or gathering animation. Henry just reaches out a hand, with the herb rustle sound. Nothing else changes.</description>
